# ==============================================================================
# NUBIMART — ENVIRONMENT CONFIGURATION TEMPLATE
# DO NOT COMMIT REAL SECRETS TO SOURCE CONTROL
# ==============================================================================

# APP CONFIGURATION
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME="NUBIMART"
NEXT_PUBLIC_APP_TAGLINE="One Marketplace. Infinite Possibilities."

# DATABASE CONFIGURATION
# Development (SQLite zero-configuration fallback):
DATABASE_URL="file:./dev.db"
# Production (PostgreSQL):
# DATABASE_URL="postgresql://nubimart_user:your_password@localhost:5432/nubimart_db?schema=public"

# AUTHENTICATION & SECURITY
JWT_SECRET=super-secret-jwt-development-key-change-in-production-min-32-chars
NEXTAUTH_SECRET=super-secret-nextauth-development-key-change-in-production
NEXTAUTH_URL=http://localhost:3000

# INITIAL ADMIN SEED ACCOUNT
ADMIN_EMAIL=admin@nubimart.com
ADMIN_PASSWORD=AdminSecurePassword2026!

# MULTI-CURRENCY & INTERNATIONALIZATION
NEXT_PUBLIC_DEFAULT_CURRENCY=USD
NEXT_PUBLIC_DEFAULT_COUNTRY=US

# PAYMENT PROVIDERS (TEST / SANDBOX CREDENTIALS)
# Paystack (Primary West Africa & African Launch Markets)
PAYSTACK_PUBLIC_KEY=pk_test_sample_paystack_key
PAYSTACK_SECRET_KEY=sk_test_sample_paystack_key
PAYSTACK_WEBHOOK_SECRET=sample_webhook_secret

# Flutterwave (Pan-African Multi-Currency)
FLUTTERWAVE_PUBLIC_KEY=FLWPUBK_TEST-sample
FLUTTERWAVE_SECRET_KEY=FLWSECK_TEST-sample
FLUTTERWAVE_ENCRYPTION_KEY=FLWSECK_TEST_ENCRYPTION_KEY

# Stripe (Global & North America / Europe)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_sample_stripe_key
STRIPE_SECRET_KEY=sk_test_sample_stripe_key
STRIPE_WEBHOOK_SECRET=whsec_sample_stripe_webhook_secret

# LOGISTICS & SHIPPING PROVIDERS (DEVELOPMENT MOCK / SANDBOX)
DHL_API_KEY=dhl_sample_key
FEDEX_API_KEY=fedex_sample_key

# AI SERVICES (OPTIONAL ENHANCEMENT)
OPENAI_API_KEY=
GEMINI_API_KEY=
